table benchmark_analytics
	lineageTag: 3535d707-9493-456f-bf5a-cb12bd90a54e
	sourceLineageTag: [benchmark_repository].[benchmark_analytics]

	measure 'Total Time' = ```
			SUM(benchmark_analytics[stage_time_delta])
			
			```
		lineageTag: e9b04e6c-c661-49ae-b39e-62f32f8270be

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Time' = AVERAGEX(SUMMARIZE(benchmark_analytics, [platform], [workload_name], [configuration],[cu_per_second], [run_timestamp], "total_time", [Total Time]), [total_time])
		lineageTag: 2beb9be0-37cd-404b-ad3a-72e8cb1f1e96

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Run Count' = DISTINCTCOUNT(benchmark_analytics[run_timestamp])
		formatString: 0
		lineageTag: 69f3d9e4-4f6e-4588-85df-55b3ce430ce1

		changedProperty = Name

	measure 'Median Stage Time' = MEDIAN(benchmark_analytics[stage_time_delta])
		lineageTag: 94ddbaa0-91f6-4d6c-a849-6bd3c860f017

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Cost' = AVERAGEX(ADDCOLUMNS(SUMMARIZE(benchmark_analytics, [platform], [workload_name], [configuration],[cu_per_second], [run_timestamp], "total_time", [Total Time]), "cost", [Total Time] * [cu_per_second]), [cost])
		lineageTag: 70f5b1bc-3372-4d3e-8618-49abf8bdeaec

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median Cost' = MEDIANX(ADDCOLUMNS(SUMMARIZE(benchmark_analytics, [platform], [workload_name], [configuration],[cu_per_second], [run_timestamp], "total_time", [Total Time]), "cost", [Total Time] * [cu_per_second]), [cost])
		lineageTag: 3f90632c-9c10-454a-a59f-73bc5eae50c7

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median Time' = AVERAGEX(SUMMARIZE(benchmark_analytics, [platform], [workload_name], [configuration],[cu_per_second], [run_timestamp], "total_time", [Total Time]), [total_time])
		lineageTag: 0e6d41e6-a41e-40dd-b3fe-7330ed40e767

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

